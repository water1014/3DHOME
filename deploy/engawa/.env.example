# Point a DNS A/AAAA record for this hostname at your server first.
ENGAWA_DOMAIN=mcp.example.com

# Replace with a long random secret. Keep the real .env file off GitHub.
ENGAWA_TOKEN=replace-with-a-long-random-token

# Default observation location: Nanjing, China (UTC+8). Change these if you prefer another location.
ENGAWA_LAT=32.0603
ENGAWA_LON=118.7969
ENGAWA_TZ_OFFSET=8
